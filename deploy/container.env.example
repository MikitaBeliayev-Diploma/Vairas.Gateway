# Example only: replace DNS names and mount/trust the actual downstream CA.
# TLS terminates at the explicitly trusted ingress below. Direct TLS can instead
# use ASPNETCORE_HTTPS_PORTS=8443 and Kestrel certificate configuration/mounts.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=api.example.test
Gateway__Issuer=https://identity.example.test
Gateway__MetadataAddress=https://authentication.internal/.well-known/openid-configuration
Gateway__BrowserOrigins__0=https://app.example.test
Gateway__ForwardedHosts__0=api.example.test
Gateway__TrustedProxies__0=10.0.0.10
Gateway__Services__authentication__Address=https://authentication.internal/
Gateway__Services__user-management__Address=https://user-management.internal/
Gateway__Services__school-management__Address=https://school-management.internal/
Gateway__Services__scheduling__Address=https://scheduling.internal/
Gateway__Services__vehicle-management__Address=https://vehicle-management.internal/
Gateway__Services__learning-tracking__Address=https://learning-tracking.internal/
Gateway__Services__notifications__Address=https://notifications.internal/
Gateway__Services__document-management__Address=https://document-management.internal/
Gateway__Services__chat__Address=https://chat.internal/
